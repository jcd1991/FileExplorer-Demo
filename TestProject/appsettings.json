{
  "FileBrowser": {
    "RootPath": "SampleFiles",
    "MaxUploadBytes": 104857600,
    "UploadCopyBufferBytes": 65536,
    "UploadStreamBufferBytes": 4096,
    "MaxConcurrentUploads": 0,
    "SnapshotCacheMaxViews": 16,
    "SnapshotCacheMaxBytes": 67108864
  },
  "Diagnostics": { "Enabled": false },
  "Cors": { "AllowedOrigins": [] },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "AllowedHosts": "*"
}
